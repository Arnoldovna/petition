{
  "name": "petition",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "dev:setup": "node scripts/dev-setup.mjs",
    "demo": "node scripts/dev-setup.mjs --demo",
    "dev": "pnpm assets:fonts .dev && pnpm run --parallel \"/^dev:(server|css|client)$/\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:css": "tailwindcss -i src/styles/main.css -o .dev/public/assets/app.css --watch",
    "dev:client": "node scripts/build-client.mjs --dev",
    "build": "pnpm build:assets && tsc -p tsconfig.build.json",
    "build:css": "tailwindcss -i src/styles/main.css -o dist/public/assets/app.css --minify && node scripts/hash-css.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:assets": "node -e \"for (const dir of ['dist/public', 'dist/signature-fonts']) require('node:fs').rmSync(dir, { recursive: true, force: true })\" && pnpm assets:fonts dist && pnpm build:css && pnpm build:client && node scripts/write-manifest.mjs",
    "assets:fonts": "node scripts/copy-fonts.mjs",
    "assets:glyphs": "node scripts/font-glyphs.mjs",
    "start": "node --enable-source-maps dist/server.js",
    "lint": "eslint . --max-warnings=0 && knip && node scripts/check-views.mjs",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings=0",
    "check:utilities": "node scripts/check-no-utilities.mjs .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/client/tsconfig.json && tsc -p e2e/tsconfig.json",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:e2e": "node scripts/run-e2e.mjs",
    "e2e:up": "node scripts/run-e2e.mjs --up",
    "e2e:down": "node scripts/run-e2e.mjs --down",
    "secrets:scan": "gitleaks git --redact --no-banner && gitleaks dir . --config .gitleaks.dir.toml --redact --no-banner",
    "verify": "pnpm format:check && pnpm lint && pnpm lint:css && pnpm check:utilities && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build && pnpm test:e2e && pnpm secrets:scan",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "stack:up": "docker compose --profile app up -d --build --wait",
    "stack:demo": "docker compose --profile demo up -d --build --wait",
    "stack:down": "docker compose --profile app --profile demo down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "pnpm assets:fonts .dev && SEED_ALLOW=true tsx --env-file-if-exists=.env src/tools/seed.ts",
    "admin:erase": "tsx --env-file-if-exists=.env src/tools/erase-user.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.1.1",
    "argon2": "0.45.2",
    "compression": "1.8.2",
    "connect-redis": "10.0.0",
    "cookie-parser": "1.4.7",
    "csrf-csrf": "4.1.0",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-handlebars": "9.0.6",
    "express-rate-limit": "8.7.4",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "rate-limit-redis": "6.0.2",
    "redis": "6.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/schibsted-grotesk": "5.3.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/cli": "4.3.5",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.3",
    "eslint-plugin-import-x": "4.18.1",
    "fontkit": "2.0.4",
    "globals": "17.14.0",
    "knip": "6.45.1",
    "lefthook": "2.2.2",
    "lint-staged": "17.6.0",
    "node-html-parser": "9.0.7",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "supertest": "7.3.2",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
