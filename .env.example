# Local configuration for `pnpm dev`, `pnpm demo` and the e2e stack (OVERVIEW.md section 16).
# `pnpm setup:env` copies this file to .env and fills the empty SECRET and PASSWORD keys with random values; it never
# overwrites a value. Never commit .env. SEED_ALLOW and E2E_BASE_URL are deliberately not here: the seed scripts and
# scripts/run-e2e.mjs set them per invocation (ADR 0019 section 7).

# --- Application (validated by src/config/env.ts at startup) ---

# development | test | production. Development serves unhashed assets from .dev/ and never reads a manifest.
NODE_ENV=development
# HTTP port of `pnpm dev` (the containers always listen on 3000).
PORT=3000
# pino level: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=debug
# Number of reverse proxies in front of the app (0 to 5); decides the client IP for rate limits.
TRUST_PROXY=0
# Postgres for `pnpm dev`. Must name the same user, password, database and port as the POSTGRES_* keys below
# (`pnpm dev:setup` checks this).
DATABASE_URL=postgres://petition:local-only@127.0.0.1:5432/petition
# Redis for sessions and rate limits; the port must match REDIS_PORT.
REDIS_URL=redis://127.0.0.1:6379
# "Served over https": secure __Host- cookies, HSTS, upgrade-insecure-requests. Defaults to true in production;
# false here because local development is plain http.
COOKIE_SECURE=false
# Signs session cookies: a comma-separated list, each at least 32 characters; the first one signs (rotation).
# Generated by `pnpm setup:env`.
SESSION_SECRET=
# Signs the CSRF double-submit token, at least 32 characters. Generated by `pnpm setup:env`.
CSRF_SECRET=
# A session ends after this many minutes without a request (5 to 1440).
SESSION_IDLE_MINUTES=120
# A session ends this many hours after sign-in, whatever the activity (1 to 720).
SESSION_ABSOLUTE_HOURS=168
# Requests per minute and client IP across the whole app (1 to 100000).
RATE_LIMIT_GLOBAL_MAX=300
# Sign-in and registration attempts per 15 minutes, per IP subnet and per email (1 to 100000); the per-email login
# limit is 10 times this value per hour.
RATE_LIMIT_AUTH_MAX=10
# https:// link for the footer and the privacy page.
CONTACT_URL=https://github.com/Arnoldovna
# Optional https:// link to the operator's imprint; empty shows no link. Required for a public deployment.
IMPRINT_URL=
# IANA time zone for every date shown on a page.
APP_TIME_ZONE=Europe/Berlin
# Password of the seeded demo accounts (at least 12 characters); `pnpm demo` prints it with the demo login.
# Generated by `pnpm setup:env`.
SEED_DEMO_PASSWORD=

# --- Docker Compose (docker-compose.yml) ---

# Fixed local credentials of the Postgres container; never generated, so an existing data volume keeps working when
# .env is recreated. The database only listens on 127.0.0.1.
POSTGRES_USER=petition
POSTGRES_PASSWORD=local-only
POSTGRES_DB=petition
# Host ports of the development infrastructure (127.0.0.1 only).
POSTGRES_PORT=5432
REDIS_PORT=6379
# Host port of the production image for `pnpm stack:up` and `pnpm demo`.
APP_PORT=3000
# Host port of the isolated e2e stack (compose project petition-e2e); the environment wins over this value.
E2E_PORT=8182
