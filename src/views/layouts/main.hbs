{{!--
  Temporary phase-1a layout. Phase 1b replaces it with the final, frozen layout of OVERVIEW.md section 15.1
  (site-header and site-footer partials, flash region, icons and manifest). Only classes that already exist in
  src/styles are used here (check:utilities).
--~}}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}} · Nonsense Petition</title>
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f85d33" />
    <link
      rel="preload"
      href="/fonts/schibsted-grotesk-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="{{asset 'app.css'}}" />
    <script type="module" src="{{asset 'form-guard.js'}}"></script>
    {{#each scripts}}
      <script type="module" src="{{asset this}}"></script>
    {{/each}}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
      <a href="/">nonsense petition</a>
    </header>
    <main id="main" tabindex="-1">
      {{{body}}}
    </main>
    <footer>
      <p>a nonsense petition by Arnoldovna</p>
    </footer>
  </body>
</html>
