{{!--
  pages/signature/thank-you (ROUTES.md section 5, F-46 to F-48, F-50).
  Model (ThankYouView): supporterCount (the supporters module's total, F-47) and imageSrc (the private image route).
  The count is the page's one display-size number ("1 supporter", "1,284 supporters"). The rows link to the list and
  to the delete confirmation, which only signers can reach (B-47, ADR 0013).
--}}
{{> page-heading title="Thank you for your signature"}}
{{> signature-frame src=imageSrc alt="Your signature"}}
<p class="supporter-count">
  <span class="supporter-count__number">{{formatCount supporterCount}}</span>
  <span class="supporter-count__label">{{plural supporterCount "supporter" "supporters"}}</span>
</p>
{{#> row-list}}
  {{> list-row href="/supporters" title="see all supporters" meta=""}}
  {{> list-row href="/signature/delete" title="delete signature" meta=""}}
{{/row-list}}
