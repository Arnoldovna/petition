{{!--
  confirm-panel (OVERVIEW.md section 15.2; parameters frozen): title, items, action, buttonLabel, cancelHref,
  cancelLabel.
  The confirmation step before a deletion (ADR 0013, F-50, F-67): what will happen (items, plain strings), a POST
  form whose primary button is the destructive action, and a text link that keeps everything. The page's h1 comes
  from page-heading, so the panel title is an h2. Fields the action needs (the current password on account delete)
  go into the form through the partial block, wrapped in confirm-panel__fields; without a block the form holds only the
  CSRF token. The form is guarded against double submits like every form (data-guard, F-75).
  Usage:
    {{#> confirm-panel title="Delete your signature?" items=consequences action="/signature/delete"
         buttonLabel="delete my signature" cancelHref="/thank-you" cancelLabel="keep my signature"}}
      {{> form-field form=form name="currentPassword" ...}}   (optional)
    {{/confirm-panel}}
--}}
<section class="confirm-panel" aria-labelledby="confirm-panel-title">
  <h2 class="confirm-panel__title" id="confirm-panel-title">{{title}}</h2>
  {{#if items.length}}
    <ul class="confirm-panel__list">
      {{#each items}}
        <li class="confirm-panel__item">{{this}}</li>
      {{/each}}
    </ul>
  {{/if}}
  <form class="confirm-panel__form" method="post" action="{{action}}" novalidate data-guard>
    {{> csrf-field}}
    {{#if @partial-block}}
      <div class="confirm-panel__fields">
        {{> @partial-block}}
      </div>
    {{/if}}
    <div class="confirm-panel__actions">
      {{> button type="submit" label=buttonLabel modifier="button--primary"}}
      <a class="confirm-panel__cancel" href="{{cancelHref}}">{{cancelLabel}}</a>
    </div>
  </form>
</section>
